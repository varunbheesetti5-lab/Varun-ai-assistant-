<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Varun AI Assistant</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
            background: #000000;
            background-image: 
                radial-gradient(circle at 20% 50%, rgba(120, 119, 198, 0.3) 0%, transparent 50%),
                radial-gradient(circle at 80% 20%, rgba(255, 119, 198, 0.3) 0%, transparent 50%),
                radial-gradient(circle at 40% 80%, rgba(120, 219, 255, 0.3) 0%, transparent 50%);
            background-attachment: fixed;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #ffffff;
        }

        /* Main App */
        .app-container {
            width: 95vw;
            max-width: 1200px;
            height: 95vh;
            background: rgba(10, 10, 10, 0.9);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 20px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.8);
            backdrop-filter: blur(20px);
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        .header {
            background: linear-gradient(135deg, #1a1a1a, #2a2a2a);
            color: white;
            padding: 20px;
            text-align: center;
            position: relative;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }

        .header h1 {
            font-size: 28px;
            font-weight: 700;
            background: linear-gradient(135deg, #8b5cf6, #06b6d4);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            text-shadow: none;
        }

        .api-status {
            position: absolute;
            top: 20px;
            right: 20px;
            padding: 8px 12px;
            background: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 20px;
            font-size: 12px;
            display: flex;
            align-items: center;
            gap: 8px;
            backdrop-filter: blur(10px);
        }

        .status-dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: #10b981;
            animation: pulse 2s infinite;
            box-shadow: 0 0 10px rgba(16, 185, 129, 0.6);
        }

        .status-dot.error {
            background: #ef4444;
            box-shadow: 0 0 10px rgba(239, 68, 68, 0.6);
        }

        @keyframes pulse {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.7; transform: scale(1.1); }
        }

        .chat-container {
            flex: 1;
            display: flex;
            flex-direction: column;
            padding: 25px;
            overflow: hidden;
        }

        .messages {
            flex: 1;
            overflow-y: auto;
            margin-bottom: 25px;
            padding-right: 15px;
        }

        /* Custom Scrollbar */
        .messages::-webkit-scrollbar {
            width: 6px;
        }

        .messages::-webkit-scrollbar-track {
            background: rgba(255, 255, 255, 0.05);
            border-radius: 10px;
        }

        .messages::-webkit-scrollbar-thumb {
            background: rgba(139, 92, 246, 0.5);
            border-radius: 10px;
        }

        .messages::-webkit-scrollbar-thumb:hover {
            background: rgba(139, 92, 246, 0.7);
        }

        .message {
            margin-bottom: 20px;
            display: flex;
            align-items: flex-start;
            animation: slideIn 0.4s ease;
        }

        @keyframes slideIn {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .message.user {
            justify-content: flex-end;
        }

        .message-content {
            max-width: 75%;
            padding: 18px 22px;
            border-radius: 20px;
            word-wrap: break-word;
            line-height: 1.6;
            font-size: 15px;
            position: relative;
        }

        .message.user .message-content {
            background: linear-gradient(135deg, #8b5cf6, #6366f1);
            color: white;
            border-bottom-right-radius: 8px;
            box-shadow: 0 4px 20px rgba(139, 92, 246, 0.3);
        }

        .message.ai .message-content {
            background: rgba(255, 255, 255, 0.05);
            color: #e5e7eb;
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-bottom-left-radius: 8px;
            backdrop-filter: blur(10px);
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
        }

        .typing-indicator {
            display: none;
            align-items: center;
            gap: 12px;
            color: #9ca3af;
            font-style: italic;
            margin-bottom: 20px;
            padding: 15px;
        }

        .typing-indicator.show {
            display: flex;
        }

        .dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: #8b5cf6;
            animation: typing 1.4s infinite ease-in-out;
            box-shadow: 0 0 10px rgba(139, 92, 246, 0.4);
        }

        .dot:nth-child(2) { animation-delay: 0.2s; }
        .dot:nth-child(3) { animation-delay: 0.4s; }

        @keyframes typing {
            0%, 60%, 100% { transform: translateY(0); opacity: 0.4; }
            30% { transform: translateY(-15px); opacity: 1; }
        }

        .input-area {
            display: flex;
            gap: 15px;
            align-items: flex-end;
            background: rgba(255, 255, 255, 0.05);
            padding: 20px;
            border-radius: 25px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
        }

        .input-container {
            flex: 1;
            position: relative;
        }

        #messageInput {
            width: 100%;
            min-height: 55px;
            max-height: 150px;
            padding: 15px 20px;
            background: rgba(0, 0, 0, 0.3);
            border: 2px solid rgba(255, 255, 255, 0.2);
            border-radius: 25px;
            font-size: 16px;
            font-family: inherit;
            color: #ffffff;
            resize: none;
            outline: none;
            transition: all 0.3s ease;
        }

        #messageInput:focus {
            border-color: #8b5cf6;
            box-shadow: 0 0 25px rgba(139, 92, 246, 0.3);
            background: rgba(0, 0, 0, 0.4);
        }

        #messageInput::placeholder {
            color: rgba(255, 255, 255, 0.6);
        }

        .send-button {
            width: 55px;
            height: 55px;
            border: none;
            border-radius: 50%;
            background: linear-gradient(135deg, #8b5cf6, #06b6d4);
            color: white;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            font-weight: bold;
            transition: all 0.3s ease;
            box-shadow: 0 4px 20px rgba(139, 92, 246, 0.4);
        }

        .send-button:hover {
            transform: scale(1.1) translateY(-2px);
            box-shadow: 0 8px 30px rgba(139, 92, 246, 0.6);
        }

        .send-button:disabled {
            background: rgba(255, 255, 255, 0.1);
            cursor: not-allowed;
            transform: none;
            box-shadow: none;
        }

        /* Enhanced Code Blocks */
        pre {
            background: linear-gradient(135deg, #1a1a2e, #16213e);
            color: #f8f8f2;
            padding: 20px;
            border-radius: 12px;
            overflow-x: auto;
            margin: 15px 0;
            font-size: 14px;
            border: 1px solid rgba(139, 92, 246, 0.3);
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
            position: relative;
        }

        pre::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: linear-gradient(90deg, #8b5cf6, #06b6d4, #10b981);
            border-radius: 12px 12px 0 0;
        }

        code {
            font-family: 'Fira Code', 'JetBrains Mono', 'Cascadia Code', Monaco, monospace;
            font-weight: 500;
        }

        /* Inline code */
        .message-content code:not(pre code) {
            background: rgba(139, 92, 246, 0.2);
            color: #c792ea;
            padding: 3px 8px;
            border-radius: 6px;
            font-size: 0.9em;
            border: 1px solid rgba(139, 92, 246, 0.3);
        }

        .citation {
            color: #06b6d4;
            font-weight: 600;
            cursor: pointer;
            background: rgba(6, 182, 212, 0.1);
            padding: 2px 6px;
            border-radius: 4px;
            border: 1px solid rgba(6, 182, 212, 0.3);
            transition: all 0.3s ease;
        }

        .citation:hover {
            background: rgba(6, 182, 212, 0.2);
            transform: scale(1.05);
        }

        .error-message {
            background: linear-gradient(135deg, rgba(239, 68, 68, 0.1), rgba(185, 28, 28, 0.1));
            color: #fca5a5;
            padding: 15px;
            border-radius: 10px;
            margin: 15px 0;
            border-left: 4px solid #ef4444;
            border: 1px solid rgba(239, 68, 68, 0.3);
        }

        /* Enhanced Image and Link Styles */
        .message-content img {
            max-width: 100%;
            height: auto;
            border-radius: 12px;
            margin: 15px 0;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
            border: 1px solid rgba(255, 255, 255, 0.1);
            transition: transform 0.3s ease;
        }

        .message-content img:hover {
            transform: scale(1.02);
        }

        .message-content a {
            color: #06b6d4;
            text-decoration: none;
            font-weight: 500;
            padding: 2px 6px;
            border-radius: 6px;
            background: rgba(6, 182, 212, 0.1);
            border: 1px solid rgba(6, 182, 212, 0.3);
            transition: all 0.3s ease;
        }

        .message-content a:hover {
            background: rgba(6, 182, 212, 0.2);
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(6, 182, 212, 0.3);
        }

        /* Enhanced formatting */
        .message-content strong {
            color: #fbbf24;
            font-weight: 700;
        }

        .message-content em {
            color: #a78bfa;
            font-style: italic;
        }

        .message-content h1, .message-content h2, .message-content h3 {
            color: #8b5cf6;
            margin: 15px 0 10px 0;
        }

        .message-content ul, .message-content ol {
            margin: 10px 0;
            padding-left: 20px;
        }

        .message-content li {
            margin: 5px 0;
            color: #d1d5db;
        }

        @media (max-width: 768px) {
            .app-container {
                width: 98vw;
                height: 98vh;
                border-radius: 15px;
            }
            
            .message-content {
                max-width: 90%;
                padding: 15px 18px;
            }

            .header h1 {
                font-size: 24px;
            }

            .chat-container {
                padding: 20px;
            }

            .input-area {
                padding: 15px;
            }
        }

        /* Loading animation for better UX */
        .loading {
            opacity: 0.7;
            pointer-events: none;
        }

        /* Welcome message special styling */
        .welcome-message {
            background: linear-gradient(135deg, rgba(139, 92, 246, 0.1), rgba(99, 102, 241, 0.1));
            border: 1px solid rgba(139, 92, 246, 0.3);
        }
    </style>
</head>
<body>
    <!-- Main App (No Login Required) -->
    <div class="app-container" id="appContainer">
        <div class="header">
            <h1>Varun AI Assistant</h1>
            <div class="api-status" id="apiStatus" aria-live="polite">
                <span class="status-dot" id="statusDot"></span>
                <span id="statusText">Connected</span>
            </div>
        </div>

        <div class="chat-container">
            <div class="messages" id="messages">
                <div class="message ai">
                    <div class="message-content welcome-message">
                        🎉 <strong>Welcome to Varun AI Assistant!</strong><br><br>
                        
                        I'm your advanced AI Assistant powered by <strong>OpenAI GPT</strong>. Here's what I can do for you:<br><br>
                        
                        🔥 <strong>Core Capabilities:</strong><br>
                        • <strong>Code Generation</strong> - Python, JavaScript, React, HTML/CSS, SQL, and 50+ languages<br>
                        • <strong>Code Debugging</strong> - Find and fix bugs in your code<br>
                        • <strong>Code Explanation</strong> - Understand complex algorithms and functions<br>
                        • <strong>Technical Documentation</strong> - Write READMEs, API docs, and tutorials<br>
                        • <strong>System Architecture</strong> - Design scalable applications<br><br>
                        
                        ✨ <strong>Advanced Features:</strong><br>
                        • **Complete code projects** with multiple files<br>
                        • **Visual content** with images and diagrams<br>
                        • **Interactive links** to resources and documentation<br>
                        • **Real-time research** with up-to-date information<br>
                        • **Context memory** - I remember our entire conversation<br><br>
                        
                        💡 <strong>Quick Start Examples:</strong><br>
                        • *"Build a complete React todo app with code"*<br>
                        • *"Explain machine learning algorithms with examples"*<br>
                        • *"Create a Python web scraper with error handling"*<br>
                        • *"Design a database schema for an e-commerce app"*<br><br>
                        
                        Ready to build something amazing? <strong>What can I help you code today?</strong> 🚀
                    </div>
                </div>
            </div>

            <div class="typing-indicator" id="typingIndicator" aria-live="polite">
                🤖 AI is thinking
                <div class="dot"></div>
                <div class="dot"></div>
                <div class="dot"></div>
            </div>

            <div class="input-area">
                <div class="input-container">
                    <textarea id="messageInput" aria-label="Message input" placeholder="Ask me to code anything..." rows="1"></textarea>
                </div>
                <button class="send-button" id="sendButton" aria-label="Send message" title="Send message" onclick="sendMessage()">
                    ▶
                </button>
            </div>
        </div>
    </div>

    <script>
        // API Configuration with your key
        const CONFIG = {
            apiKey: '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',
            apiEndpoint: 'https://openrouter.ai/api/v1/chat/completions',
            model: 'openai/gpt-3.5-turbo',
            maxTokens: 3000,
            temperature: 0.7
        };

        // State management
        let conversationHistory = [];
        let messageCount = 0;

        // DOM Elements
        const messagesContainer = document.getElementById('messages');
        const messageInput = document.getElementById('messageInput');
        const sendButton = document.getElementById('sendButton');
        const typingIndicator = document.getElementById('typingIndicator');
        const statusText = document.getElementById('statusText');
        const statusDot = document.getElementById('statusDot');

        // Initialize application
        function init() {
            // Enhanced message input handlers
            messageInput.addEventListener('input', function() {
                this.style.height = 'auto';
                this.style.height = Math.min(this.scrollHeight, 150) + 'px';
                sendButton.disabled = this.value.trim() === '';
                
                // Add visual feedback
                if (this.value.trim()) {
                    sendButton.style.background = 'linear-gradient(135deg, #8b5cf6, #06b6d4)';
                } else {
                    sendButton.style.background = 'rgba(255, 255, 255, 0.1)';
                }
            });

            // Set initial input state
            messageInput.dispatchEvent(new Event('input'));

            messageInput.addEventListener('keydown', function(e) {
                if (e.key === 'Enter' && !e.shiftKey) {
                    e.preventDefault();
                    if (!sendButton.disabled) {
                        sendMessage();
                    }
                }
            });

            sendButton.disabled = true;
            
            // Focus on input and show ready status
            setTimeout(() => {
                messageInput.focus();
                updateStatus('connected', '✅ Ready to Code!');
            }, 1000);
        }

        // Status management
        function updateStatus(type, text) {
            statusText.textContent = text;
            statusDot.className = 'status-dot';
            
            if (type === 'error') {
                statusDot.classList.add('error');
            }
        }

        // OpenAI API integration
        async function callOpenAI(message) {
            // Add system prompt for better coding assistance
            if (conversationHistory.length === 0) {
                conversationHistory.push({
                    role: 'system',
                    content: `You are Varun AI Assistant, an expert coding assistant. Always provide:
1. Complete, working code examples
2. Detailed explanations
3. Best practices and tips
4. Links to documentation when helpful
5. Use markdown formatting for code blocks
6. Include relevant images/diagrams when explaining concepts
7. Be comprehensive and educational in your responses`
                });
            }

            conversationHistory.push({ role: 'user', content: message });

            const response = await fetch(CONFIG.apiEndpoint, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Authorization': `Bearer ${CONFIG.apiKey}`,
                    'HTTP-Referer': window.location.href,
                    'X-Title': 'Varun AI Assistant'
                },
                body: JSON.stringify({
                    model: CONFIG.model,
                    messages: conversationHistory,
                    max_tokens: CONFIG.maxTokens,
                    temperature: CONFIG.temperature,
                    stream: false
                })
            });

            if (!response.ok) {
                const errorData = await response.json();
                throw new Error(errorData.error?.message || `API Error: ${response.status}`);
            }

            const data = await response.json();
            const aiMessage = data.choices[0].message.content;
            
            conversationHistory.push({ role: 'assistant', content: aiMessage });
            
            // Keep conversation manageable (last 30 messages)
            if (conversationHistory.length > 31) {
                // Keep system prompt + last 30 messages
                conversationHistory = [
                    conversationHistory[0],
                    ...conversationHistory.slice(-30)
                ];
            }

            return aiMessage;
        }

        // Enhanced markdown formatting
        function formatMessage(text) {
            function escapeHtml(unsafe) {
                return unsafe
                    .replace(/&/g, "&amp;")
                    .replace(/</g, "&lt;")
                    .replace(/>/g, "&gt;");
            }

            // Format headers
            text = text.replace(/^### (.*$)/gm, '<h3>$1</h3>');
            text = text.replace(/^## (.*$)/gm, '<h2>$1</h2>');
            text = text.replace(/^# (.*$)/gm, '<h1>$1</h1>');

            // Format images: ![alt](url)
            text = text.replace(
                /!\[([^\]]*)\]\((https?:\/\/[^\s)]+)\)/g,
                '<img src="$2" alt="$1" loading="lazy" />'
            );

            // Format links: [text](url)
            text = text.replace(
                /\[([^\]]+)\]\((https?:\/\/[^\s)]+)\)/g,
                '<a href="$2" target="_blank" rel="noopener noreferrer">$1</a>'
            );

            // Format code blocks with language detection
            text = text.replace(/```(\w+)?\n([\s\S]*?)```/g, (match, lang, code) => {
                const language = lang ? ` data-language="${lang}"` : '';
                return `<pre${language}><code>${escapeHtml(code.trim())}</code></pre>`;
            });
            
            // Format inline code
            text = text.replace(/`([^`]+)`/g, '<code>$1</code>');
            
            // Format citations
            text = text.replace(/\[(\d+)\]/g, '<span class="citation">[$1]</span>');
            
            // Format lists
            text = text.replace(/^\* (.+)$/gm, '<li>$1</li>');
            text = text.replace(/(<li>.*<\/li>)/s, '<ul>$1</ul>');
            
            // Format bold
            text = text.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
            
            // Format italic
            text = text.replace(/\*([^*]+)\*/g, '<em>$1</em>');
            
            // Format line breaks
            text = text.replace(/\n/g, '<br>');
            
            return text;
        }

        // Message handling
        function addMessage(content, isUser = false) {
            const messageDiv = document.createElement('div');
            messageDiv.className = `message ${isUser ? 'user' : 'ai'}`;
            
            const contentDiv = document.createElement('div');
            contentDiv.className = 'message-content';
            
            if (isUser) {
                contentDiv.textContent = content;
            } else {
                contentDiv.innerHTML = formatMessage(content);
                
                // Add copy buttons to code blocks
                const codeBlocks = contentDiv.querySelectorAll('pre');
                codeBlocks.forEach(pre => {
                    const copyBtn = document.createElement('button');
                    copyBtn.textContent = '📋 Copy';
                    copyBtn.style.cssText = `
                        position: absolute;
                        top: 10px;
                        right: 10px;
                        background: rgba(139, 92, 246, 0.8);
                        border: none;
                        color: white;
                        padding: 5px 10px;
                        border-radius: 5px;
                        font-size: 12px;
                        cursor: pointer;
                        transition: background 0.3s ease;
                    `;
                    copyBtn.setAttribute('aria-label', 'Copy code to clipboard');
                    copyBtn.setAttribute('title', 'Copy code to clipboard');
                    copyBtn.onclick = () => {
                        const codeEl = pre.querySelector('code');
                        const textToCopy = codeEl ? codeEl.innerText : pre.textContent;
                        navigator.clipboard.writeText(textToCopy);
                        copyBtn.textContent = '✅ Copied!';
                        copyBtn.setAttribute('aria-label', 'Copied to clipboard');
                        copyBtn.setAttribute('title', 'Copied to clipboard');
                        setTimeout(() => {
                            copyBtn.textContent = '📋 Copy';
                            copyBtn.setAttribute('aria-label', 'Copy code to clipboard');
                            copyBtn.setAttribute('title', 'Copy code to clipboard');
                        }, 2000);
                    };
                    pre.style.position = 'relative';
                    pre.appendChild(copyBtn);
                });
            }
            
            messageDiv.appendChild(contentDiv);
            messagesContainer.appendChild(messageDiv);
            
            // Smooth scroll to bottom
            messagesContainer.scrollTo({
                top: messagesContainer.scrollHeight,
                behavior: 'smooth'
            });
            
            messageCount++;
        }

        // Typing indicator
        function showTyping() {
            typingIndicator.classList.add('show');
            messagesContainer.scrollTo({
                top: messagesContainer.scrollHeight,
                behavior: 'smooth'
            });
        }

        function hideTyping() {
            typingIndicator.classList.remove('show');
        }

        // Main message sending function
        async function sendMessage() {
            const message = messageInput.value.trim();
            if (!message) return;

            // Add loading state
            document.getElementById('appContainer').classList.add('loading');
            addMessage(message, true);
            
            // Clear and reset input
            messageInput.value = '';
            messageInput.style.height = 'auto';
            sendButton.disabled = true;
            sendButton.style.background = 'rgba(255, 255, 255, 0.1)';

            showTyping();
            updateStatus('thinking', '🧠 Processing...');

            try {
                const response = await callOpenAI(message);
                hideTyping();
                addMessage(response, false);
                updateStatus('connected', '✅ Ready');
                
                // Success feedback
                sendButton.style.background = 'linear-gradient(135deg, #10b981, #059669)';
                setTimeout(() => {
                    sendButton.style.background = 'rgba(255, 255, 255, 0.1)';
                }, 1000);
                
            } catch (error) {
                hideTyping();
                console.error('OpenAI API Error:', error);
                
                let errorMessage = `**❌ Error occurred:**\n\n${error.message}\n\n`;
                
                if (error.message.includes('401')) {
                    errorMessage += '🔑 **Issue:** Invalid API key\n**Solution:** Check your OpenAI API key configuration';
                } else if (error.message.includes('429')) {
                    errorMessage += '⏰ **Issue:** Rate limit exceeded\n**Solution:** Please wait a moment and try again';
                } else if (error.message.includes('quota')) {
                    errorMessage += '💳 **Issue:** API quota exceeded\n**Solution:** Check your OpenAI account billing';
                } else {
                    errorMessage += '🔧 **Solution:** Please try again in a moment. If the issue persists, check your internet connection.';
                }
                
                addMessage(errorMessage, false);
                updateStatus('error', '❌ Error');
            } finally {
                document.getElementById('appContainer').classList.remove('loading');
                messageInput.focus();
            }
        }

        // Initialize the application
        init();

        // Add helpful keyboard shortcuts
        document.addEventListener('keydown', function(e) {
            // Ctrl/Cmd + Enter to send message
            if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
                if (!sendButton.disabled) {
                    sendMessage();
                }
            }
            
            // Escape to clear input
            if (e.key === 'Escape') {
                messageInput.value = '';
                messageInput.style.height = 'auto';
                sendButton.disabled = true;
                messageInput.focus();
            }
        });
    </script>
</body>
</html>